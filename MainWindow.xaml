<Window x:Class="ForpakLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velox Client" Width="1180" Height="700" MinWidth="1000" MinHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon.ico">

    <Window.Resources>
        <!-- Navigation latérale (style Velox Tweaks) -->
        <Style x:Key="SideNav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="10" Padding="12,6">
                            <Grid>
                                <Border x:Name="bar" Width="3" CornerRadius="2" Background="{StaticResource Accent}"
                                        HorizontalAlignment="Left" Margin="-12,2,0,2" Opacity="0"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#0E1A26"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#0F2628"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#2A6B5E"/>
                                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sous-menu (Modrinth / CurseForge) -->
        <Style x:Key="SubNav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="10,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#0E1A26"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter TargetName="b" Property="Background" Value="#0F2628"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interrupteur Modrinth / CurseForge (rond blanc qui glisse) -->
        <Style x:Key="SourceToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="60" Height="32" CornerRadius="16" BorderThickness="1"
                                BorderBrush="#33FFFFFF">
                            <Border.Background>
                                <SolidColorBrush x:Name="TrackBrush" Color="#1BD96A"/>
                            </Border.Background>
                            <Ellipse Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobMove" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X"
                                                             To="28" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color"
                                                            To="#F16436" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="TrackBrush" Storyboard.TargetProperty="Color"
                                                            To="#1BD96A" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carte en verre -->
        <Style x:Key="Glass" TargetType="Border">
            <Setter Property="Background" Value="#D9091222"/>
            <Setter Property="BorderBrush" Value="#2E3EE6A8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Gros bouton JOUER -->
        <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2FD39A" Offset="0"/>
                                    <GradientStop Color="#14A880" Offset="0.5"/>
                                    <GradientStop Color="#0C86AE" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#3EE6A8" BlurRadius="30" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#5BF0BC" BlurRadius="40" ShadowDepth="0" Opacity="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pastille (onglets, catégories) -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="#E60D1526" BorderBrush="#22304A" BorderThickness="1"
                                CornerRadius="15" Padding="14,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#3EE6A8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource ButtonFill}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carte d'un mod -->
        <Style x:Key="ModCard" TargetType="Border">
            <Setter Property="Background" Value="#E00B1424"/>
            <Setter Property="BorderBrush" Value="#22304A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3EE6A8"/>
                    <Setter Property="Background" Value="#F00F1A2E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" SizeChanged="Root_SizeChanged" CornerRadius="16" BorderBrush="#2E3EE6A8"
            BorderThickness="1" Background="{StaticResource Bg}"
            TextElement.FontFamily="{StaticResource MainFont}" TextElement.Foreground="{StaticResource Text}">
        <Border.Clip>
            <RectangleGeometry x:Name="WindowClip" RadiusX="16" RadiusY="16"/>
        </Border.Clip>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- =================== FOND ANIMÉ (parallax) =================== -->
            <Grid x:Name="BgRoot" Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True"
                  RenderOptions.BitmapScalingMode="NearestNeighbor">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#070B16" Offset="0"/>
                            <GradientStop Color="#0B1530" Offset="0.55"/>
                            <GradientStop Color="#16306A" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="StarsRect" Height="540" VerticalAlignment="Top">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="StarsBrush" ImageSource="pack://application:,,,/Assets/stars.png"
                                    TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,1920,540" Stretch="Fill"/>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Aurores boréales -->
                <Rectangle x:Name="Aurora2Rect" Height="540" VerticalAlignment="Top" Opacity="0.8">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="Aurora2Brush" ImageSource="pack://application:,,,/Assets/aurora2.png"
                                    TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,1920,540" Stretch="Fill"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="Aurora1Rect" Height="540" VerticalAlignment="Top">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="Aurora1Brush" ImageSource="pack://application:,,,/Assets/aurora1.png"
                                    TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,1920,540" Stretch="Fill"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Image x:Name="Moon" Source="pack://application:,,,/Assets/moon.png" Width="200" Height="200"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,120,0"/>
                <Rectangle Height="540" VerticalAlignment="Bottom">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="Layer1Brush" ImageSource="pack://application:,,,/Assets/layer1.png"
                                    TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,1920,540" Stretch="Fill"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Height="540" VerticalAlignment="Bottom">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="Layer2Brush" ImageSource="pack://application:,,,/Assets/layer2.png"
                                    TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,1920,540" Stretch="Fill"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Height="540" VerticalAlignment="Bottom">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="Layer3Brush" ImageSource="pack://application:,,,/Assets/layer3.png"
                                    TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,1920,540" Stretch="Fill"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Height="540" VerticalAlignment="Bottom">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="Layer4Brush" ImageSource="pack://application:,,,/Assets/layer4.png"
                                    TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,1920,540" Stretch="Fill"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas x:Name="Particles"/>
                <!-- Assombrit le centre pour que le texte reste lisible -->
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.58,0.5" GradientOrigin="0.58,0.5" RadiusX="0.45" RadiusY="0.6">
                            <GradientStop Color="#A0060A14" Offset="0"/>
                            <GradientStop Color="#00060A14" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- =================== BARRE LATÉRALE =================== -->
            <Border Grid.Column="0" Background="#EE080D19" BorderBrush="#141B2C" BorderThickness="0,0,1,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <DockPanel Margin="16,22,16,16">
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,20">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="46" Height="46"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="Bold"><Run Text="VELOX"/><Run Text="." Foreground="{StaticResource Accent}"/></TextBlock>
                            <TextBlock Text="C L I E N T" FontSize="9.5" Foreground="{StaticResource Muted}" Margin="1,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bas : mise à jour + compte -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="Mise à jour" FontSize="12"
                                Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed" Click="Update_Click"/>
                        <Button x:Name="AccountButton" Style="{StaticResource GhostButton}" Padding="8,7"
                                HorizontalContentAlignment="Stretch" Background="#0E1424" Click="Account_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="34" Height="34">
                                    <Border CornerRadius="8" Background="{StaticResource Stroke}">
                                        <TextBlock x:Name="AvatarLetter" Text="?" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontWeight="Bold"/>
                                    </Border>
                                    <Image x:Name="AvatarImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountName" Text="Se connecter" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="AccountHint" Text="Compte Microsoft" FontSize="10.5"
                                               Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <DockPanel Margin="4,10,0,0">
                            <TextBlock DockPanel.Dock="Right" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,0,4,0"><Run Text="made by "/><Run Text="forpak" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></TextBlock>
                            <TextBlock x:Name="VersionLabel" FontSize="10.5" Foreground="{StaticResource Muted}"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Navigation (défile si la fenêtre est petite) -->
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <RadioButton x:Name="NavHome" Style="{StaticResource SideNav}" GroupName="nav" IsChecked="True"
                                     Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Text="Accueil" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Lancer le jeu" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMods" Style="{StaticResource SideNav}" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Text="Mods" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Modrinth &amp; CurseForge" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavPacks" Style="{StaticResource SideNav}" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Text="Modpacks" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Packs Modrinth &amp; .mrpack" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavServers" Style="{StaticResource SideNav}" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Text="Serveurs" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Favoris &amp; joueurs en ligne" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavShots" Style="{StaticResource SideNav}" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Text="Captures" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Tes screenshots" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavLogs" Style="{StaticResource SideNav}" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Text="Logs" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Crashs &amp; journaux" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource SideNav}" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Text="Paramètres" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="RAM, Java &amp; options" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Nouveautés -->
                        <Border Background="#0E1424" BorderBrush="#1A2030" BorderThickness="1" CornerRadius="10"
                                Padding="12,10" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="NOUVEAUTÉS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                <TextBlock x:Name="NewsTitle" Text="Velox Client" FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock x:Name="NewsText" TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource Muted}"
                                           Margin="0,4,0,0" MaxHeight="58" TextTrimming="CharacterEllipsis"
                                           Text="Shift droit en jeu : menu des modules et éditeur de HUD. G = ToggleSprint, V = ToggleSneak, C = Zoom."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- =================== ZONE PRINCIPALE =================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barre de titre -->
                <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="Minimize_Click"/>
                        <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" Click="Close_Click" Margin="0,0,6,0"/>
                    </StackPanel>
                </Grid>

                <!-- ============ ACCUEIL : lancement au centre ============ -->
                <Grid x:Name="HomePage" Grid.Row="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Margin="0,-30,0,0">
                        <Image x:Name="HeroLogo" Source="pack://application:,,,/Assets/logo.png" Width="112" Height="112"
                               RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TranslateTransform x:Name="HeroFloat"/>
                            </Image.RenderTransform>
                        </Image>
                        <TextBlock HorizontalAlignment="Center" FontSize="56" FontWeight="Bold" Margin="0,10,0,0">
                            <Run Text="VELOX"/><Run Text="." Foreground="{StaticResource Accent}"/>
                        </TextBlock>
                        <TextBlock Text="C  L  I  E  N  T" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#8CF5CF" Margin="0,-6,0,0"/>
                        <TextBlock x:Name="SubtitleText" HorizontalAlignment="Center" TextAlignment="Center" FontSize="14"
                                   Foreground="#C9D2E3" TextWrapping="Wrap" Margin="0,14,0,24"/>

                        <!-- Carte de lancement -->
                        <Border Style="{StaticResource Glass}" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="VersionCombo" Style="{StaticResource DarkCombo}" Height="58"/>
                                    <Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource PlayButtonStyle}" Content="JOUER"
                                            Width="210" Height="58" Margin="12,0,0,0" Click="Play_Click"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <CheckBox x:Name="FabricSwitch" Style="{StaticResource Switch}" Content="Fabric"
                                              Checked="Fabric_Changed" Unchecked="Fabric_Changed"/>
                                    <CheckBox x:Name="PerfSwitch" Style="{StaticResource Switch}" Content="Pack FPS" Margin="26,0,0,0"
                                              Checked="Perf_Changed" Unchecked="Perf_Changed"/>
                                    <CheckBox x:Name="ClientSwitch" Style="{StaticResource Switch}" Content="Modules PvP" Margin="26,0,0,0"
                                              Checked="Client_Changed" Unchecked="Client_Changed"/>
                                </StackPanel>
                                <Grid Margin="2,16,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusText" Text="Chargement des versions..." FontSize="12"
                                               Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="PercentText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Accent}"/>
                                </Grid>
                                <ProgressBar x:Name="Bar" Height="4" Margin="2,8,2,0" Background="{StaticResource Stroke}"
                                             Foreground="{StaticResource Accent}" BorderThickness="0" Maximum="1" Visibility="Hidden"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============ MODS (pages façon Modrinth) ============ -->
                <Grid x:Name="ModsPage" Grid.Row="1" Margin="24,0,24,22" Visibility="Collapsed">

                    <!-- ===== Liste / recherche ===== -->
                    <Grid x:Name="BrowseView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Titre + onglets -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Mods" FontSize="26" FontWeight="Bold"/>
                                <Border Background="#263EE6A8" CornerRadius="6" Padding="8,3" Margin="12,4,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ModsVersionText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                </Border>
                                <!-- Choix de la source -->
                                <Border Background="#E60D1526" BorderBrush="#22304A" BorderThickness="1" CornerRadius="22"
                                        Padding="12,5" Margin="18,2,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel x:Name="ModrinthSide" Orientation="Horizontal" Cursor="Hand" Background="Transparent"
                                                    MouseLeftButtonUp="ModrinthSide_Click">
                                            <Image x:Name="ModrinthLogo" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="ModrinthLabel" Text="Modrinth" FontSize="13" FontWeight="SemiBold"
                                                       Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SourceSwitch" Style="{StaticResource SourceToggle}" Margin="12,0"
                                                  VerticalAlignment="Center" Checked="Source_Checked" Unchecked="Source_Checked"/>
                                        <StackPanel x:Name="CurseForgeSide" Orientation="Horizontal" Cursor="Hand" Background="Transparent"
                                                    MouseLeftButtonUp="CurseForgeSide_Click">
                                            <TextBlock x:Name="CurseForgeLabel" Text="CurseForge" FontSize="13" FontWeight="SemiBold"
                                                       Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                            <Image x:Name="CurseForgeLogo" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <RadioButton x:Name="ModsTabBrowse" Style="{StaticResource Pill}" GroupName="modtab" Content="Découvrir"
                                             IsChecked="True" Checked="ModsTab_Checked"/>
                                <RadioButton x:Name="ModsTabInstalled" Style="{StaticResource Pill}" GroupName="modtab" Content="Installés"
                                             Margin="6,0,0,0" Checked="ModsTab_Checked"/>
                            </StackPanel>
                        </Grid>

                        <!-- Recherche + tri -->
                        <Grid x:Name="SearchRow" Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="ModSearchBox" Style="{StaticResource DarkTextBox}" KeyDown="ModSearch_KeyDown"
                                         Padding="34,10,10,10" Background="#E6080D19"/>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                            <ComboBox x:Name="SortCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" Width="190" Height="40"
                                      Margin="8,0,0,0" SelectionChanged="Sort_Changed">
                                <ComboBoxItem Tag="relevance" Content="Pertinence" IsSelected="True"/>
                                <ComboBoxItem Tag="downloads" Content="Téléchargements"/>
                                <ComboBoxItem Tag="follows" Content="Populaires"/>
                                <ComboBoxItem Tag="newest" Content="Nouveautés"/>
                                <ComboBoxItem Tag="updated" Content="Mis à jour"/>
                            </ComboBox>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Rechercher" FontSize="13"
                                    Padding="18,0" Height="40" Margin="8,0,0,0" Click="ModSearch_Click"/>
                        </Grid>

                        <!-- Catégories -->
                        <WrapPanel x:Name="CategoryChips" Grid.Row="2" Margin="0,12,0,4"/>

                        <!-- Résultats -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <ScrollViewer x:Name="ModScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ModResults">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ModCard}" Tag="{Binding}" MouseLeftButtonUp="ModCard_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource Stroke}"
                                                            VerticalAlignment="Top" ClipToBounds="True">
                                                        <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <Grid Grid.Column="1" Margin="14,0,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="Bold" FontSize="15"/>
                                                                <Run Text="{Binding Info, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                                                            </TextBlock>
                                                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding InstallLabel}"
                                                                    FontSize="11.5" Padding="12,5" Margin="8,0,0,0" Tag="{Binding}"
                                                                    Click="InstallMod_Click"/>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="#C9D2E3" FontSize="12"
                                                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                                        <Grid Grid.Row="2" Margin="0,8,0,0">
                                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="#22304A" CornerRadius="5" Padding="7,2" Margin="0,0,5,0">
                                                                            <TextBlock Text="{Binding}" FontSize="10.5" Foreground="#C9D2E3"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Downloads}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Margin="4,0,10,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Follows}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Mods installés -->
                            <Border x:Name="InstalledView" Style="{StaticResource Glass}" Visibility="Collapsed" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock x:Name="InstalledCount" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Ouvrir le dossier" HorizontalAlignment="Right"
                                                Padding="12,6" Click="OpenMods_Click"/>
                                    </Grid>
                                    <ListBox x:Name="InstalledList" Grid.Row="1" Style="{StaticResource CleanList}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#E6080D19" CornerRadius="10" Padding="12,9" Margin="0,0,8,8"
                                                        BorderBrush="#22304A" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}"
                                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12.5"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FileName}"/>
                                                        <Button Grid.Column="2" Style="{StaticResource TitleButton}" Width="28" Height="24"
                                                                Content="&#xE74D;" ToolTip="Supprimer" Tag="{Binding}" Click="RemoveMod_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                                <TextBlock x:Name="ModsEmptyText" Foreground="{StaticResource Muted}" FontSize="13"
                                           TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/>
                                <StackPanel x:Name="CfKeyPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,14,0,0" Visibility="Collapsed">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Ajouter ma clé" FontSize="13"
                                            Click="CfKeyGoSettings_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Obtenir une clé" Margin="8,0,0,0"
                                            Click="CfKeyWeb_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Pages -->
                        <StackPanel x:Name="Pager" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button x:Name="PrevPageButton" Style="{StaticResource GhostButton}" Click="PrevPage_Click" Padding="14,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="Précédent" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Border Background="#E6080D19" CornerRadius="8" Padding="16,7" Margin="10,0">
                                <TextBlock x:Name="PageText" Text="Page 1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                            <Button x:Name="NextPageButton" Style="{StaticResource GhostButton}" Click="NextPage_Click" Padding="14,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Suivant"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Page d'un mod ===== -->
                    <Grid x:Name="DetailView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="12,7" Click="DetailBack_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Retour aux mods" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- En-tête -->
                        <Border Grid.Row="1" Style="{StaticResource Glass}" Margin="0,12,0,12" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="96" Height="96" CornerRadius="18" Background="{StaticResource Stroke}" ClipToBounds="True">
                                    <Image x:Name="DetailIcon" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailTitle" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DetailDesc" FontSize="13.5" Foreground="#C9D2E3" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <StackPanel x:Name="DetailStats" Orientation="Horizontal" Margin="0,10,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button x:Name="DetailInstall" Style="{StaticResource PrimaryButton}" Content="Installer" FontSize="15"
                                            Width="180" Height="46" Click="DetailInstall_Click"/>
                                    <Button x:Name="DetailWebButton" Style="{StaticResource GhostButton}" Content="Voir sur Modrinth"
                                            Margin="0,8,0,0" Click="DetailWeb_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Contenu -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="290"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Glass}" Padding="22,18">
                                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <WrapPanel x:Name="DetailGallery" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="DetailBody"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource Glass}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="VERSIONS COMPATIBLES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                            <ItemsControl x:Name="DetailVersions" Margin="0,10,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#E6080D19" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="12.5"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,56,0"/>
                                                                    <Border Background="#263EE6A8" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding Type}" FontSize="10" Foreground="{StaticResource Accent}"/>
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0">
                                                                    <Run Text="{Binding Date, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Downloads, Mode=OneWay}"/><Run Text=" téléch."/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Glass}" Padding="16" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="INFOS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                            <StackPanel x:Name="DetailInfo" Margin="0,10,0,0"/>
                                            <WrapPanel x:Name="DetailLinks" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ============ MODPACKS ============ -->
                <Grid x:Name="PacksPage" Grid.Row="1" Margin="24,0,24,22" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Modpacks" FontSize="26" FontWeight="Bold"/>
                            <Border Background="#263EE6A8" CornerRadius="6" Padding="8,3" Margin="12,4,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Modrinth · Fabric" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton x:Name="PacksTabBrowse" Style="{StaticResource Pill}" GroupName="packtab" Content="Découvrir"
                                         IsChecked="True" Checked="PacksTab_Checked"/>
                            <RadioButton x:Name="PacksTabInstalled" Style="{StaticResource Pill}" GroupName="packtab" Content="Installés"
                                         Margin="6,0,0,0" Checked="PacksTab_Checked"/>
                            <Button Style="{StaticResource GhostButton}" Content="Importer un .mrpack" Margin="10,0,0,6"
                                    Padding="12,6" Click="ImportPack_Click"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <Grid x:Name="PackSearchRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="PackSearchBox" Style="{StaticResource DarkTextBox}" KeyDown="PackSearch_KeyDown"
                                         Padding="34,10,10,10" Background="#E6080D19"/>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Rechercher" FontSize="13"
                                    Padding="18,0" Height="40" Margin="8,0,0,0" Click="PackSearch_Click"/>
                        </Grid>
                        <Grid x:Name="PackProgressRow" Margin="2,10,2,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PackStatusText" FontSize="12" Foreground="{StaticResource Muted}"/>
                            <ProgressBar x:Name="PackBar" Grid.Row="1" Height="4" Margin="0,6,0,0" Background="{StaticResource Stroke}"
                                         Foreground="{StaticResource Accent}" BorderThickness="0" Maximum="1"/>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <ScrollViewer x:Name="PackScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PackResults">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ModCard}" Tag="{Binding}" MouseLeftButtonUp="PackCard_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource Stroke}"
                                                        VerticalAlignment="Top" ClipToBounds="True">
                                                    <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Info}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding InstallLabel}"
                                                                FontSize="11.5" Padding="12,5" Margin="8,0,0,0" VerticalAlignment="Top"
                                                                Tag="{Binding}" Click="InstallPack_Click"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}" Foreground="#C9D2E3" FontSize="12"
                                                               TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Downloads}" FontSize="11.5" FontWeight="SemiBold" Margin="4,0,10,0"/>
                                                        <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Follows}" FontSize="11.5" FontWeight="SemiBold" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ScrollViewer x:Name="InstalledPacksView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <ItemsControl x:Name="InstalledPacks">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ModCard}" Cursor="Arrow">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource Stroke}"
                                                        VerticalAlignment="Top" ClipToBounds="True">
                                                    <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Info}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <Button Style="{StaticResource PrimaryButton}" Content="Jouer" FontSize="12" Padding="16,6"
                                                                Tag="{Binding}" Click="PlayPack_Click"/>
                                                        <Button Style="{StaticResource GhostButton}" Content="Dossier" FontSize="12" Padding="12,5"
                                                                Margin="6,0,0,0" Tag="{Binding}" Click="PackFolder_Click"/>
                                                        <Button Style="{StaticResource GhostButton}" Content="Supprimer" FontSize="12" Padding="12,5"
                                                                Margin="6,0,0,0" Tag="{Binding}" Click="DeletePack_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="PacksEmptyText" Foreground="{StaticResource Muted}" FontSize="13" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <StackPanel x:Name="PackPager" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button x:Name="PackPrevButton" Style="{StaticResource GhostButton}" Content="‹  Précédent" Click="PackPrev_Click" Padding="14,7"/>
                        <Border Background="#E6080D19" CornerRadius="8" Padding="16,7" Margin="10,0">
                            <TextBlock x:Name="PackPageText" Text="Page 1" FontWeight="SemiBold"/>
                        </Border>
                        <Button x:Name="PackNextButton" Style="{StaticResource GhostButton}" Content="Suivant  ›" Click="PackNext_Click" Padding="14,7"/>
                    </StackPanel>
                </Grid>

                <!-- ============ SERVEURS ============ -->
                <Grid x:Name="ServersPage" Grid.Row="1" Margin="24,0,24,22" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Serveurs" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="tes favoris, joueurs en ligne et ping" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="12,6,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="12,6" Click="RefreshServers_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Actualiser" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Glass}" Padding="14" Margin="0,14,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Nom" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,4"/>
                                <TextBox x:Name="ServerNameBox" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Adresse (ex : play.monserveur.fr)" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,4"/>
                                <TextBox x:Name="ServerAddressBox" Style="{StaticResource DarkTextBox}" KeyDown="ServerAddress_KeyDown"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Ajouter" FontSize="13"
                                    Margin="10,0,0,0" VerticalAlignment="Bottom" Height="36" Click="AddServer_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ServerList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ModCard}" Cursor="Arrow" Margin="0,0,6,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="56" Height="56" CornerRadius="10" Background="{StaticResource Stroke}" ClipToBounds="True">
                                                    <Image Source="{Binding Favicon}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                                    <TextBlock>
                                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" FontSize="15"/>
                                                        <Run Text="{Binding Address, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Motd}" FontSize="12" Foreground="#C9D2E3" Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PlayersText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding PingText}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Jouer" FontSize="12.5" Padding="18,7"
                                                            Tag="{Binding}" Click="JoinServer_Click"/>
                                                    <Button Style="{StaticResource TitleButton}" Width="30" Height="30" Margin="6,0,0,0"
                                                            Content="&#xE74D;" ToolTip="Retirer" Tag="{Binding}" Click="RemoveServer_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="ServersEmptyText" Foreground="{StaticResource Muted}" FontSize="13" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Text="Ajoute tes serveurs préférés pour voir qui est en ligne et les rejoindre en un clic."/>
                    </Grid>
                </Grid>

                <!-- ============ CAPTURES ============ -->
                <Grid x:Name="ShotsPage" Grid.Row="1" Margin="24,0,24,22" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Captures d'écran" FontSize="26" FontWeight="Bold"/>
                            <TextBlock x:Name="ShotsCount" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="12,6,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="Actualiser" Padding="12,6" Click="RefreshShots_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ShotsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="232" Height="150" CornerRadius="12" Margin="0,0,12,12" ClipToBounds="True"
                                                Background="{StaticResource Stroke}" Cursor="Hand" Tag="{Binding}"
                                                MouseLeftButtonUp="Shot_Click" MouseRightButtonUp="Shot_RightClick" ToolTip="Clic : ouvrir · Clic droit : copier">
                                            <Grid>
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                <Border VerticalAlignment="Bottom" Padding="10,6">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00080D19" Offset="0"/>
                                                            <GradientStop Color="#E0080D19" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="ShotsEmptyText" Foreground="{StaticResource Muted}" FontSize="13" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Text="Pas encore de captures. En jeu, appuie sur F2 pour en prendre une."/>
                    </Grid>
                </Grid>

                <!-- ============ LOGS ============ -->
                <Grid x:Name="LogsPage" Grid.Row="1" Margin="24,0,24,22" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Logs" FontSize="26" FontWeight="Bold"/>
                            <TextBlock x:Name="LogsCount" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="12,6,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="Supprimer les crashs" Padding="12,6" Margin="0,0,8,0" Click="ClearCrashes_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Actualiser" Padding="12,6" Click="RefreshLogs_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Liste -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                            <ItemsControl x:Name="LogsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Card" CornerRadius="10" Padding="12,9" Margin="0,0,0,8" Cursor="Hand"
                                                Background="{StaticResource Panel}" BorderBrush="{Binding Border}" BorderThickness="1"
                                                Tag="{Binding}" MouseLeftButtonUp="LogItem_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Dot}"
                                                        VerticalAlignment="Top" Margin="0,5,10,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Sub}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Reason}" FontSize="10.5" Foreground="#FF8A8A"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding ReasonVis}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="DeleteLog_Click"
                                                        ToolTip="Supprimer" Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Top"
                                                        Cursor="Hand" Foreground="{StaticResource Muted}" FontSize="11">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#40FF5C5C"/>
                                                                    <Setter Property="Foreground" Value="#FF8A8A"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="LogsEmptyText" Foreground="{StaticResource Muted}" FontSize="13" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="Wrap"
                                   Text="Aucun log pour l'instant." Visibility="Collapsed"/>

                        <!-- Lecteur -->
                        <Border Grid.Column="1" Style="{StaticResource Glass}" Background="#F0091222" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,200,0">
                                        <TextBlock x:Name="LogViewTitle" Text="Choisis un log à gauche" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="LogViewPath" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="LogCopyButton" Style="{StaticResource PrimaryButton}" Content="Copier" Padding="14,6"
                                                Margin="0,0,8,0" Click="CopyLog_Click" IsEnabled="False"/>
                                        <Button x:Name="LogFolderButton" Style="{StaticResource GhostButton}" Content="Ouvrir le dossier"
                                                Padding="12,6" Click="OpenLogFolder_Click" IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="LogViewer" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap"
                                         FontFamily="Consolas" FontSize="11.5" Background="#060A14" Foreground="#CFD8E8"
                                         BorderThickness="0" Padding="10" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============ PARAMÈTRES ============ -->
                <Border x:Name="SettingsPage" Grid.Row="1" Style="{StaticResource Glass}" Margin="24,0,24,24" Padding="28"
                        Background="#F0091222" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Paramètres" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="JEU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,22,0,0"/>
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Mémoire (RAM)" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RamText" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="RamSlider" Minimum="1024" Maximum="16384" TickFrequency="512"
                                        IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="Ram_Changed"/>
                                <TextBlock Text="4 à 6 Go suffisent pour le PvP. Trop de RAM peut faire des micro-lags."
                                           FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                                <TextBlock Text="Chemin de Java (vide = automatique)" FontWeight="SemiBold" Margin="0,18,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="JavaBox" Style="{StaticResource DarkTextBox}"/>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="..." Margin="8,0,0,0"
                                            Click="BrowseJava_Click"/>
                                </Grid>

                                <TextBlock Text="Arguments JVM en plus" FontWeight="SemiBold" Margin="0,18,0,6"/>
                                <TextBox x:Name="JvmBox" Style="{StaticResource DarkTextBox}"/>

                                <TextBlock Text="CURSEFORGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,26,0,0"/>
                                <TextBlock Text="Clé API CurseForge (gratuite)" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CfKeyBox" Style="{StaticResource DarkTextBox}"/>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Obtenir" Margin="8,0,0,0"
                                            Click="CfKeyWeb_Click"/>
                                </Grid>
                                <TextBlock x:Name="CfKeyHint" Text="À créer sur console.curseforge.com. Sans clé, seul Modrinth marche."
                                           FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,46,0,0">
                                <TextBlock Text="LAUNCHER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                <CheckBox x:Name="ForpakClientSwitch" Style="{StaticResource Switch}"
                                          Content="Modules PvP (mod Velox Client, 1.21.1 / 1.21.11)" Margin="0,16,0,0"/>
                                <CheckBox x:Name="PerfSettingSwitch" Style="{StaticResource Switch}"
                                          Content="Pack FPS (Sodium, Lithium...)" Margin="0,12,0,0"/>
                                <CheckBox x:Name="AnimSwitch" Style="{StaticResource Switch}"
                                          Content="Fond animé" Margin="0,12,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Temps du fond" VerticalAlignment="Center" Margin="0,0,12,6"
                                               Foreground="{StaticResource Muted}"/>
                                    <RadioButton x:Name="WeatherSnow" Style="{StaticResource Pill}" GroupName="bgweather"
                                                 Content="Neige" Tag="snow" Checked="BgWeather_Checked"/>
                                    <RadioButton x:Name="WeatherRain" Style="{StaticResource Pill}" GroupName="bgweather"
                                                 Content="Pluie" Tag="rain" Checked="BgWeather_Checked"/>
                                    <RadioButton x:Name="WeatherNone" Style="{StaticResource Pill}" GroupName="bgweather"
                                                 Content="Rien" Tag="none" Checked="BgWeather_Checked"/>
                                </StackPanel>
                                <CheckBox x:Name="DiscordSwitch" Style="{StaticResource Switch}"
                                          Content="Statut Discord (« Joue à Velox Client »)" Margin="0,12,0,0"/>
                                <CheckBox x:Name="SnapshotSwitch" Style="{StaticResource Switch}" Content="Afficher les snapshots"
                                          Margin="0,12,0,0"/>
                                <CheckBox x:Name="CloseSwitch" Style="{StaticResource Switch}" Content="Cacher le launcher pendant le jeu"
                                          Margin="0,12,0,0"/>

                                <TextBlock Text="DOSSIERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,26,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="Dossier du launcher" Click="OpenFolder_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Dossier mods" Click="OpenMods_Click" Margin="8,0,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,34,0,0">
                                    <TextBlock x:Name="SavedText" Text="Enregistré ✓" Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Enregistrer" Click="SaveSettings_Click" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- =================== Connexion =================== -->
            <Grid x:Name="LoginOverlay" Grid.ColumnSpan="2" Background="#CC060A14" Visibility="Collapsed">
                <Border Width="420" Style="{StaticResource Glass}" Background="#F20E1424" Padding="30" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Connexion Microsoft" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Va sur la page qui vient de s'ouvrir et entre ce code :" Margin="0,8,0,0"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource Bg}" CornerRadius="10" Padding="16" Margin="0,18,0,0">
                            <TextBlock x:Name="LoginCode" Text="--------" FontSize="30" FontWeight="Bold"
                                       FontFamily="Consolas" HorizontalAlignment="Center" Foreground="{StaticResource Accent}"/>
                        </Border>
                        <TextBlock x:Name="LoginUrl" Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Copier le code" Click="CopyCode_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Annuler" Click="CancelLogin_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
