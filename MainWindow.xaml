<Window x:Class="ForpakLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forpak Client" Width="1120" Height="680" MinWidth="960" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon.ico">

    <Window.Resources>
        <!-- Onglets de navigation -->
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,26,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,2"/>
                            <Border x:Name="Line" Height="3" CornerRadius="2" Background="{StaticResource Accent}"
                                    VerticalAlignment="Bottom" Opacity="0" Margin="0,0,0,8"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter TargetName="Line" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carte en verre -->
        <Style x:Key="Glass" TargetType="Border">
            <Setter Property="Background" Value="#CC12141A"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Gros bouton JOUER -->
        <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4BE894" Offset="0"/>
                                    <GradientStop Color="#2FB86C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#3DDC84" BlurRadius="28" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3DDC84" BlurRadius="36" ShadowDepth="0" Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" SizeChanged="Root_SizeChanged" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1" Background="{StaticResource Bg}"
            TextElement.FontFamily="{StaticResource MainFont}" TextElement.Foreground="{StaticResource Text}">
        <Border.Clip>
            <RectangleGeometry x:Name="WindowClip" RadiusX="16" RadiusY="16"/>
        </Border.Clip>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Fond pixel-art ===== -->
            <Image Grid.RowSpan="2" Source="pack://application:,,,/Assets/bg.png" Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Bottom"/>
            <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F00B0C10" Offset="0"/>
                        <GradientStop Color="#A00B0C10" Offset="0.45"/>
                        <GradientStop Color="#300B0C10" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E00B0C10" Offset="0"/>
                        <GradientStop Color="#000B0C10" Offset="0.18"/>
                        <GradientStop Color="#000B0C10" Offset="0.7"/>
                        <GradientStop Color="#C00B0C10" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ===== Barre du haut ===== -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,40,0">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock Text="FORPAK" FontSize="17" FontWeight="Black" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="CLIENT" FontSize="17" FontWeight="Light" Foreground="{StaticResource Accent}"
                               Margin="5,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionLabel" FontSize="10" Foreground="{StaticResource Muted}"
                               Margin="8,4,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavTab}" Content="ACCUEIL" GroupName="nav"
                                 IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavMods" Style="{StaticResource NavTab}" Content="MODS" GroupName="nav"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavTab}" Content="PARAMÈTRES" GroupName="nav"
                                 Checked="Nav_Checked"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="Mise à jour" FontSize="11"
                            Padding="12,5" Margin="0,0,12,0" Visibility="Collapsed" Click="Update_Click"/>

                    <Button x:Name="AccountButton" Style="{StaticResource GhostButton}" Padding="6,4,14,4"
                            Background="#B016181E" Click="Account_Click" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="30" Height="30">
                                <Border CornerRadius="7" Background="{StaticResource Stroke}">
                                    <TextBlock x:Name="AvatarLetter" Text="?" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Image x:Name="AvatarImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AccountName" Text="Se connecter" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock x:Name="AccountHint" Text="Compte Microsoft" FontSize="10"
                                           Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="Minimize_Click"/>
                    <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" Click="Close_Click" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>

            <!-- ===================== ACCUEIL ===================== -->
            <Grid x:Name="HomePage" Grid.Row="1" Margin="44,10,30,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Bottom" MaxWidth="540" HorizontalAlignment="Left">
                    <Border Background="#263DDC84" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                        <TextBlock Text="CLIENT PVP · FABRIC · 1.21" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    </Border>
                    <TextBlock Text="Joue mieux." FontSize="58" FontWeight="Black" Margin="0,12,0,0"/>
                    <TextBlock x:Name="SubtitleText" Text="Modules PvP, pack FPS et mods Modrinth, en un clic."
                               FontSize="15" Foreground="#C8CCD4" TextWrapping="Wrap" Margin="0,4,0,26"/>

                    <!-- Carte de lancement -->
                    <Border Style="{StaticResource Glass}" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="VersionCombo" Style="{StaticResource DarkCombo}" Height="58"/>
                                <Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource PlayButtonStyle}" Content="JOUER"
                                        Width="200" Height="58" Margin="12,0,0,0" Click="Play_Click"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
                                <CheckBox x:Name="FabricSwitch" Style="{StaticResource Switch}" Content="Fabric"
                                          Checked="Fabric_Changed" Unchecked="Fabric_Changed"/>
                                <CheckBox x:Name="PerfSwitch" Style="{StaticResource Switch}" Content="Pack FPS" Margin="22,0,0,0"
                                          Checked="Perf_Changed" Unchecked="Perf_Changed"/>
                                <CheckBox x:Name="ClientSwitch" Style="{StaticResource Switch}" Content="Modules PvP" Margin="22,0,0,0"
                                          Checked="Client_Changed" Unchecked="Client_Changed"/>
                            </StackPanel>
                            <Grid Margin="2,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StatusText" Text="Chargement des versions..." FontSize="12"
                                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PercentText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Accent}"/>
                            </Grid>
                            <ProgressBar x:Name="Bar" Height="4" Margin="2,8,0,0" Background="{StaticResource Stroke}"
                                         Foreground="{StaticResource Accent}" BorderThickness="0" Maximum="1" Visibility="Hidden"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Colonne de droite -->
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <Border Style="{StaticResource Glass}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="OPTIMISATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="Pack FPS" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="Sodium, Lithium, FerriteCore, ImmediatelyFast, EntityCulling, ModernFix et Dynamic FPS. En général 2 à 4 fois plus de FPS qu'en vanilla."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Glass}">
                        <StackPanel>
                            <TextBlock Text="NOUVEAUTÉS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            <TextBlock x:Name="NewsTitle" Text="Forpak Client" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock x:Name="NewsText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"
                                       Margin="0,6,0,0" MaxHeight="120" TextTrimming="CharacterEllipsis"
                                       Text="Shift droit en jeu : menu des modules et éditeur de HUD. G = ToggleSprint, V = ToggleSneak, C = Zoom, F8 = cacher le HUD."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===================== MODS ===================== -->
            <Border x:Name="ModsPage" Grid.Row="1" Style="{StaticResource Glass}" Margin="30,6,30,30" Padding="22"
                    Background="#E612141A" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="270"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal">
                        <TextBlock Text="Mods" FontSize="24" FontWeight="Black"/>
                        <TextBlock x:Name="ModsVersionText" FontSize="13" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Bottom" Margin="12,0,0,4"/>
                        <TextBlock Text="· via Modrinth" FontSize="13" Foreground="{StaticResource Accent}"
                                   VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,16,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ModSearchBox" Style="{StaticResource DarkTextBox}" KeyDown="ModSearch_KeyDown"/>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Rechercher" FontSize="13"
                                Padding="16,7" Margin="8,0,0,0" Click="ModSearch_Click"/>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="2" Margin="0,16,0,14">
                        <TextBlock Text="Installés" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" Content="Ouvrir le dossier" HorizontalAlignment="Right"
                                Padding="10,5" Click="OpenMods_Click"/>
                    </Grid>

                    <ListBox x:Name="ModResults" Grid.Row="2" Style="{StaticResource CleanList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#B00E0F13" CornerRadius="10" Padding="12" Margin="0,0,6,8"
                                        BorderBrush="#1FFFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource Stroke}"
                                                VerticalAlignment="Top" ClipToBounds="True">
                                            <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,14,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}"
                                                       TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" MaxHeight="34"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Info}" Foreground="{StaticResource Muted}" FontSize="11"
                                                       Margin="0,5,0,0" Opacity="0.7"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Installer"
                                                FontSize="12" Padding="16,7" VerticalAlignment="Center"
                                                Tag="{Binding}" Click="InstallMod_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ModsEmptyText" Grid.Row="2" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <ListBox x:Name="InstalledList" Grid.Row="2" Grid.Column="2" Style="{StaticResource CleanList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#B00E0F13" CornerRadius="8" Padding="10,7" Margin="0,0,4,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip="{Binding FileName}"/>
                                        <Button Grid.Column="1" Style="{StaticResource TitleButton}" Width="26" Height="22"
                                                Content="&#xE74D;" ToolTip="Supprimer" Tag="{Binding}" Click="RemoveMod_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ===================== PARAMÈTRES ===================== -->
            <Border x:Name="SettingsPage" Grid.Row="1" Style="{StaticResource Glass}" Margin="30,6,30,30" Padding="28"
                    Background="#E612141A" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Paramètres" FontSize="24" FontWeight="Black"/>
                            <TextBlock Text="JEU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,22,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="Mémoire (RAM)" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RamText" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="RamSlider" Minimum="1024" Maximum="16384" TickFrequency="512"
                                    IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="Ram_Changed"/>
                            <TextBlock Text="4 à 6 Go suffisent pour le PvP. Trop de RAM peut faire des micro-lags."
                                       FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="Chemin de Java (vide = automatique)" FontWeight="SemiBold" Margin="0,18,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="JavaBox" Style="{StaticResource DarkTextBox}"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="..." Margin="8,0,0,0"
                                        Click="BrowseJava_Click"/>
                            </Grid>

                            <TextBlock Text="Arguments JVM en plus" FontWeight="SemiBold" Margin="0,18,0,6"/>
                            <TextBox x:Name="JvmBox" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,46,0,0">
                            <TextBlock Text="LAUNCHER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            <CheckBox x:Name="ForpakClientSwitch" Style="{StaticResource Switch}"
                                      Content="Modules PvP (Forpak Client, 1.21.1 / 1.21.11)" Margin="0,16,0,0"/>
                            <CheckBox x:Name="PerfSettingSwitch" Style="{StaticResource Switch}"
                                      Content="Pack FPS (Sodium, Lithium...)" Margin="0,12,0,0"/>
                            <CheckBox x:Name="SnapshotSwitch" Style="{StaticResource Switch}" Content="Afficher les snapshots"
                                      Margin="0,12,0,0"/>
                            <CheckBox x:Name="CloseSwitch" Style="{StaticResource Switch}" Content="Cacher le launcher pendant le jeu"
                                      Margin="0,12,0,0"/>

                            <TextBlock Text="DOSSIERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,26,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="Dossier du launcher" Click="OpenFolder_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="Dossier mods" Click="OpenMods_Click" Margin="8,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,34,0,0">
                                <TextBlock x:Name="SavedText" Text="Enregistré ✓" Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Enregistrer" Click="SaveSettings_Click" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ===================== Connexion ===================== -->
            <Grid x:Name="LoginOverlay" Grid.RowSpan="2" Background="#CC0B0C10" Visibility="Collapsed">
                <Border Width="420" Style="{StaticResource Glass}" Background="#F216181E" Padding="30" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Connexion Microsoft" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Va sur la page qui vient de s'ouvrir et entre ce code :" Margin="0,8,0,0"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource Bg}" CornerRadius="10" Padding="16" Margin="0,18,0,0">
                            <TextBlock x:Name="LoginCode" Text="--------" FontSize="30" FontWeight="Bold"
                                       FontFamily="Consolas" HorizontalAlignment="Center" Foreground="{StaticResource Accent}"/>
                        </Border>
                        <TextBlock x:Name="LoginUrl" Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Copier le code" Click="CopyCode_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Annuler" Click="CancelLogin_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
