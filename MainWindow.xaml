<Window x:Class="ForpakLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forpak Launcher" Width="980" Height="600" MinWidth="820" MinHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource Bg}" CornerRadius="14" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
            ClipToBounds="True" TextElement.FontFamily="{StaticResource MainFont}"
            TextElement.Foreground="{StaticResource Text}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Halo vert en fond -->
            <Ellipse Grid.RowSpan="3" Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-420,-380,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#333DDC84" Offset="0"/>
                        <GradientStop Color="#003DDC84" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Barre de titre -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource Accent}" Margin="0,0,10,0"/>
                    <TextBlock Text="FORPAK LAUNCHER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{StaticResource Stroke}" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="Mise à jour dispo" FontSize="11"
                            Padding="12,4" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" Click="Update_Click"/>
                    <Button Style="{StaticResource TitleButton}" Content="&#xE713;" ToolTip="Paramètres" Click="OpenSettings_Click"/>
                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="Minimize_Click"/>
                    <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Centre -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="56,0,0,0">
                <TextBlock Text="MINECRAFT" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Prêt à jouer." FontSize="52" FontWeight="Bold" Margin="0,4,0,0"/>
                <TextBlock x:Name="SubtitleText" Text="Choisis ta version et lance le jeu."
                           FontSize="15" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Barre du bas -->
            <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,14,14">
                <Grid Margin="22,16,22,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Compte -->
                    <Button x:Name="AccountButton" Grid.Column="0" Style="{StaticResource GhostButton}" Padding="8,6,16,6"
                            Click="Account_Click" Height="48">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="34" Height="34">
                                <Border CornerRadius="8" Background="{StaticResource Stroke}">
                                    <TextBlock x:Name="AvatarLetter" Text="?" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                                <Image x:Name="AvatarImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AccountName" Text="Se connecter" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="AccountHint" Text="Compte Microsoft" FontSize="11"
                                           Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Version + Fabric -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                        <CheckBox x:Name="FabricSwitch" Style="{StaticResource Switch}" Content="Fabric"
                                  VerticalAlignment="Center" Margin="0,0,18,0" Checked="Fabric_Changed" Unchecked="Fabric_Changed"/>
                        <Button x:Name="ModsButton" Style="{StaticResource GhostButton}" Content="Mods" Height="44"
                                Padding="18,0" Margin="0,0,10,0" Click="OpenMods_Overlay_Click"/>
                        <ComboBox x:Name="VersionCombo" Style="{StaticResource DarkCombo}" Width="200"/>
                    </StackPanel>

                    <Button x:Name="PlayButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="JOUER"
                            Width="170" Height="48" Click="Play_Click"/>

                    <!-- Progression -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="Chargement des versions..." FontSize="12"
                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PercentText" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </Grid>
                    <ProgressBar x:Name="Bar" Grid.Row="1" Grid.ColumnSpan="3" Height="3" Margin="0,36,0,0"
                                 Background="{StaticResource Stroke}" Foreground="{StaticResource Accent}"
                                 BorderThickness="0" Maximum="1" Visibility="Hidden"/>
                </Grid>
            </Border>

            <!-- ===================== Mods (Modrinth) ===================== -->
            <Grid x:Name="ModsOverlay" Grid.RowSpan="3" Background="#F00E0F13" Visibility="Collapsed">
                <Border Margin="36,48,36,28" Background="{StaticResource Panel}" CornerRadius="14" Padding="22"
                        BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal">
                            <TextBlock Text="Mods" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="ModsVersionText" FontSize="13" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                            <TextBlock Text="· via Modrinth" FontSize="13" Foreground="{StaticResource Accent}"
                                       VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Fermer" HorizontalAlignment="Right"
                                Click="CloseMods_Click"/>

                        <Grid Grid.Row="1" Margin="0,16,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ModSearchBox" Style="{StaticResource DarkTextBox}" KeyDown="ModSearch_KeyDown"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Rechercher" FontSize="13"
                                    Padding="16,7" Margin="8,0,0,0" Click="ModSearch_Click"/>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="2" Margin="0,16,0,12">
                            <TextBlock Text="Installés" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource GhostButton}" Content="Dossier" HorizontalAlignment="Right"
                                    Padding="10,5" Click="OpenMods_Click"/>
                        </Grid>

                        <ListBox x:Name="ModResults" Grid.Row="2" Style="{StaticResource CleanList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Bg}" CornerRadius="10" Padding="10" Margin="0,0,6,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource Stroke}"
                                                    VerticalAlignment="Top">
                                                <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}"
                                                           TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" MaxHeight="34"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Info}" Foreground="{StaticResource Muted}" FontSize="11"
                                                           Margin="0,4,0,0" Opacity="0.7"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Installer"
                                                    FontSize="12" Padding="14,6" VerticalAlignment="Center"
                                                    Tag="{Binding}" Click="InstallMod_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ModsEmptyText" Grid.Row="2" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <ListBox x:Name="InstalledList" Grid.Row="2" Grid.Column="2" Style="{StaticResource CleanList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="10,7" Margin="0,0,4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" ToolTip="{Binding FileName}"/>
                                            <Button Grid.Column="1" Style="{StaticResource TitleButton}" Width="26" Height="22"
                                                    Content="&#xE74D;" ToolTip="Supprimer" Tag="{Binding}" Click="RemoveMod_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== Fenêtre de connexion ===================== -->
            <Grid x:Name="LoginOverlay" Grid.RowSpan="3" Background="#CC0E0F13" Visibility="Collapsed">
                <Border Width="420" Background="{StaticResource Panel}" CornerRadius="14" Padding="30"
                        BorderBrush="{StaticResource Stroke}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Connexion Microsoft" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Va sur la page qui vient de s'ouvrir et entre ce code :" Margin="0,8,0,0"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource Bg}" CornerRadius="10" Padding="16" Margin="0,18,0,0">
                            <TextBlock x:Name="LoginCode" Text="--------" FontSize="30" FontWeight="Bold"
                                       FontFamily="Consolas" HorizontalAlignment="Center" Foreground="{StaticResource Accent}"/>
                        </Border>
                        <TextBlock x:Name="LoginUrl" Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Copier le code" Click="CopyCode_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Annuler" Click="CancelLogin_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== Paramètres ===================== -->
            <Grid x:Name="SettingsOverlay" Grid.RowSpan="3" Background="#CC0E0F13" Visibility="Collapsed">
                <Border Width="480" Background="{StaticResource Panel}" CornerRadius="14" Padding="30"
                        BorderBrush="{StaticResource Stroke}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Paramètres" FontSize="20" FontWeight="Bold"/>

                        <Grid Margin="0,22,0,0">
                            <TextBlock Text="Mémoire (RAM)" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RamText" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="RamSlider" Minimum="1024" Maximum="16384" TickFrequency="512"
                                IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="Ram_Changed"/>

                        <TextBlock Text="Chemin de Java (vide = automatique)" FontWeight="SemiBold" Margin="0,18,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="JavaBox" Style="{StaticResource DarkTextBox}"/>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="..." Margin="8,0,0,0"
                                    Click="BrowseJava_Click"/>
                        </Grid>

                        <TextBlock Text="Arguments JVM en plus" FontWeight="SemiBold" Margin="0,18,0,6"/>
                        <TextBox x:Name="JvmBox" Style="{StaticResource DarkTextBox}"/>

                        <CheckBox x:Name="SnapshotSwitch" Style="{StaticResource Switch}" Content="Afficher les snapshots"
                                  Margin="0,20,0,0"/>
                        <CheckBox x:Name="ForpakClientSwitch" Style="{StaticResource Switch}"
                                  Content="Forpak Client (modules PvP, 1.21.1 / 1.21.11 + Fabric)" Margin="0,12,0,0"/>
                        <CheckBox x:Name="CloseSwitch" Style="{StaticResource Switch}" Content="Fermer le launcher quand le jeu démarre"
                                  Margin="0,12,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Ouvrir le dossier du jeu" Click="OpenFolder_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Dossier mods" Click="OpenMods_Click" Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Annuler" Click="CloseSettings_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Enregistrer" Click="SaveSettings_Click" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
